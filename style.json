{
  "version": 8,
  "name": "SSD settlement change",
  "metadata": {
    "ssd:note": "Committed, diffable MapLibre style for the settlement-change viewer. The Yei pilot publishes thresholded 4 m building-presence coverage as per-year p2016/p2018/p2019/p2023 attributes in parts per ten thousand; app.js differences them at runtime. Blocks preserve that density at z4-8 and frozen 1200 m patches show from z9."
  },
  "sources": {
    "admin": {
      "type": "geojson",
      "data": "data/admin_boundaries_ssd.geojson",
      "attribution": "Boundaries & rivers © Natural Earth (public domain)"
    },
    "africa-mask": {
      "type": "geojson",
      "data": "data/africa-mask.geojson"
    },
    "rivers": {
      "type": "geojson",
      "data": "data/rivers.geojson"
    },
    "aggregates": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      },
      "attribution": "Building change © Google Open Buildings Temporal (CC BY 4.0)"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#EFEDE3"
      }
    },
    {
      "id": "africa-mask",
      "type": "fill",
      "source": "africa-mask",
      "paint": {
        "fill-color": "#D9DCD6",
        "fill-antialias": false
      }
    },
    {
      "id": "africa-coast",
      "type": "line",
      "source": "africa-mask",
      "paint": {
        "line-color": "#C4C7BC",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          2.5,
          0.5,
          6,
          0.8
        ]
      }
    },
    {
      "id": "underlay-block",
      "type": "fill",
      "source": "aggregates",
      "maxzoom": 9,
      "filter": ["==", ["get", "kind"], "block"],
      "paint": {
        "fill-color": "#C9C4B2",
        "fill-opacity": 0,
        "fill-antialias": false
      }
    },
    {
      "id": "change-fill-block",
      "type": "fill",
      "source": "aggregates",
      "maxzoom": 9,
      "filter": ["==", ["get", "kind"], "block"],
      "paint": {
        "fill-color": "#E8E6DB",
        "fill-opacity": 0.92,
        "fill-antialias": false
      }
    },
    {
      "id": "underlay",
      "type": "fill",
      "source": "aggregates",
      "minzoom": 9,
      "filter": ["==", ["get", "kind"], "patch"],
      "paint": {
        "fill-color": "#C9C4B2",
        "fill-opacity": 0,
        "fill-antialias": false
      }
    },
    {
      "id": "change-fill",
      "type": "fill",
      "source": "aggregates",
      "minzoom": 9,
      "filter": ["==", ["get", "kind"], "patch"],
      "paint": {
        "fill-color": "#E8E6DB",
        "fill-opacity": 0.92,
        "fill-antialias": false
      }
    },
    {
      "id": "rivers",
      "type": "line",
      "source": "rivers",
      "minzoom": 5,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#8FB4BE",
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0,
          6,
          0.85
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          1.0,
          9,
          1.8,
          12,
          3.0
        ]
      }
    },
    {
      "id": "admin-land",
      "type": "line",
      "source": "admin",
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "land"
      ],
      "paint": {
        "line-color": "#B7BAAC",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.6,
          8,
          1.0,
          12,
          1.6
        ]
      }
    },
    {
      "id": "admin-disputed",
      "type": "line",
      "source": "admin",
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "disputed"
      ],
      "paint": {
        "line-color": "#B7BAAC",
        "line-dasharray": [
          2,
          2
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.6,
          8,
          1.0,
          12,
          1.6
        ]
      }
    }
  ]
}
