{
  "version": 8,
  "name": "SSD settlement change",
  "metadata": {
    "ssd:note": "Committed MapLibre base style. app.js adds the public Yei loss/gain/stable PMTiles raster at runtime and styles its raw evidence channels in the browser."
  },
  "sources": {
    "admin": {
      "type": "geojson",
      "data": "data/admin_boundaries_ssd.geojson?v=20260727-23",
      "attribution": "Context © OpenFreeMap/OpenMapTiles · © OpenStreetMap contributors"
    },
    "africa-mask": {
      "type": "geojson",
      "data": "data/africa-mask.geojson?v=20260727-23"
    },
    "rivers": {
      "type": "geojson",
      "data": "data/rivers.geojson?v=20260727-23"
    },
    "analysis-extent": {
      "type": "geojson",
      "data": "data/analysis_extent.geojson?v=20260727-23",
      "attribution": "Analysis extent © geoBoundaries 6.0.0 (CC BY 4.0)"
    },
    "aggregates": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      },
      "attribution": "Building change © Google Open Buildings Temporal (CC BY 4.0)"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#EFEDE3"
      }
    },
    {
      "id": "africa-mask",
      "type": "fill",
      "source": "africa-mask",
      "paint": {
        "fill-color": "#D9DCD6",
        "fill-antialias": false
      }
    },
    {
      "id": "africa-coast",
      "type": "line",
      "source": "africa-mask",
      "paint": {
        "line-color": "#C4C7BC",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          2.5,
          0.5,
          6,
          0.8
        ]
      }
    },
    {
      "id": "analysis-mask",
      "type": "fill",
      "source": "analysis-extent",
      "filter": ["==", ["get", "kind"], "outside-analysis"],
      "paint": {
        "fill-color": "#8F928A",
        "fill-opacity": 0.04,
        "fill-antialias": false
      }
    },
    {
      "id": "analysis-edge",
      "type": "line",
      "source": "analysis-extent",
      "filter": ["==", ["get", "kind"], "analysis-edge"],
      "paint": {
        "line-color": "#858A81",
        "line-opacity": 0.2,
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4, 0.65,
          8, 0.9,
          12, 1.1
        ]
      }
    },
    {
      "id": "underlay-block",
      "type": "fill",
      "source": "aggregates",
      "layout": {"visibility": "none"},
      "minzoom": 8.5,
      "maxzoom": 9,
      "filter": ["==", ["get", "kind"], "block"],
      "paint": {
        "fill-color": "#C9C4B2",
        "fill-opacity": 0,
        "fill-antialias": false
      }
    },
    {
      "id": "change-fill-block",
      "type": "fill",
      "source": "aggregates",
      "layout": {"visibility": "none"},
      "minzoom": 8.5,
      "maxzoom": 9,
      "filter": ["==", ["get", "kind"], "block"],
      "paint": {
        "fill-color": "#E8E6DB",
        "fill-opacity": 0.92,
        "fill-antialias": false
      }
    },
    {
      "id": "underlay",
      "type": "fill",
      "source": "aggregates",
      "layout": {"visibility": "none"},
      "minzoom": 9,
      "filter": ["==", ["get", "kind"], "patch"],
      "paint": {
        "fill-color": "#C9C4B2",
        "fill-opacity": 0,
        "fill-antialias": false
      }
    },
    {
      "id": "change-fill",
      "type": "fill",
      "source": "aggregates",
      "layout": {"visibility": "none"},
      "minzoom": 9,
      "filter": ["==", ["get", "kind"], "patch"],
      "paint": {
        "fill-color": "#E8E6DB",
        "fill-opacity": 0.92,
        "fill-antialias": false
      }
    },
    {
      "id": "rivers",
      "type": "line",
      "source": "rivers",
      "minzoom": 5,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#D9E0DA",
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0,
          6,
          0.85
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          1.0,
          9,
          1.8,
          12,
          3.0
        ]
      }
    },
    {
      "id": "admin-land",
      "type": "line",
      "source": "admin",
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "land"
      ],
      "paint": {
        "line-color": "#B7BAAC",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.6,
          8,
          1.0,
          12,
          1.6
        ]
      }
    },
    {
      "id": "admin-disputed",
      "type": "line",
      "source": "admin",
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "disputed"
      ],
      "paint": {
        "line-color": "#B7BAAC",
        "line-dasharray": [
          2,
          2
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.6,
          8,
          1.0,
          12,
          1.6
        ]
      }
    }
  ]
}
